{
  "schemaVersion": 1,
  "rulesetVersion": "organic-maps-2026.10.7",
  "minimumAppVersionCode": 1,
  "createdAt": "2026-07-30T00:00:00Z",
  "publisher": "PebbleNTN maintainers",
  "rules": [
    {
      "id": "organic-maps-navigation-step",
      "enabled": true,
      "priority": 100,
      "packageNames": [
        "app.organicmaps",
        "app.organicmaps.web"
      ],
      "comment": "Same notification as its CoMaps fork (title = distance, text = road, arrow = large icon only). The app matches the icon against the app's own turn drawables (iconDrawable, #74); this map makes it a maneuver, UNKNOWN without a match. Locale-agnostic. Road line from text only (#57).",
      "conditions": [
        {
          "field": "title",
          "operator": "regex",
          "value": "(?i)^\\s*\\d+(?:[.,]\\d+)?\\s*(?:kilomet(?:re|er)s?|km|miles?|mi|feet|foot|ft|yards?|yd|met(?:re|er)s?|m)\\b"
        }
      ],
      "output": {
        "maneuver": {
          "type": "maneuverMap",
          "field": "iconDrawable",
          "mapping": {
            "ic_turn_straight": "STRAIGHT",
            "ic_turn_right": "RIGHT",
            "ic_turn_right_sharp": "SHARP_RIGHT",
            "ic_turn_right_slight": "SLIGHT_RIGHT",
            "ic_turn_left": "LEFT",
            "ic_turn_left_sharp": "SHARP_LEFT",
            "ic_turn_left_slight": "SLIGHT_LEFT",
            "ic_turn_uleft": "UTURN_LEFT",
            "ic_turn_uright": "UTURN_RIGHT",
            "ic_turn_round": "ROUNDABOUT",
            "ic_turn_finish": "ARRIVE",
            "ic_exit_highway_to_left": "SLIGHT_LEFT",
            "ic_exit_highway_to_right": "SLIGHT_RIGHT"
          },
          "default": "UNKNOWN"
        },
        "distanceMeters": {
          "type": "distance",
          "field": "title"
        },
        "primaryText": {
          "type": "firstNonEmpty",
          "fields": [
            "text"
          ]
        }
      }
    }
  ]
}
