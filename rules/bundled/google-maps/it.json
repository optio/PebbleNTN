{
  "schemaVersion": 1,
  "rulesetVersion": "google-maps-it-2026.07.4",
  "minimumAppVersionCode": 1,
  "createdAt": "2026-07-28T00:00:00Z",
  "publisher": "PebbleNTN maintainers",
  "rules": [
    {
      "id": "google-maps-arrive-it",
      "enabled": true,
      "priority": 200,
      "packageNames": [
        "com.google.android.apps.maps"
      ],
      "locales": [
        "it"
      ],
      "comment": "Title only: the ETA in subText often carries the localized 'arrive' word, so matching combinedText would classify every turn as ARRIVE.",
      "conditions": [
        {
          "field": "title",
          "operator": "regex",
          "value": "(?i)\\b(?:arriv|giunt|destinazione)"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
          "value": "ARRIVE"
        },
        "primaryText": {
          "type": "firstNonEmpty",
          "fields": [
            "title",
            "text"
          ]
        },
        "secondaryText": {
          "type": "regexCapture",
          "field": "subText",
          "pattern": "(?i)(\\d{1,2}:\\d{2}(?:\\s*[AaPp][Mm])?)\\s*$",
          "group": 1
        }
      }
    },
    {
