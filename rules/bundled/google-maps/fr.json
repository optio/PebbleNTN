  "publisher": "PebbleNTN maintainers",
  "rules": [
    {
      "id": "google-maps-roundabout-fr",
      "enabled": true,
      "priority": 190,
      "packageNames": [
        "com.google.android.apps.maps"
      ],
      "locales": [
        "fr"
      ],
      "conditions": [
        {
          "field": "combinedText",
          "operator": "regex",
          "value": "(?i)\\b(?:rond-?point|giratoire)\\b"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
          "value": "ROUNDABOUT"
        },
        "distanceMeters": {
          "type": "distance",
          "field": "combinedText"
        },
        "primaryText": {
          "type": "firstNonEmpty",
          "fields": [
            "title",
            "text"
          ]
        },
        "secondaryText": {
          "type": "regexCapture",
          "field": "subText",
          "pattern": "(?i)(\\d{1,2}:\\d{2}(?:\\s*[AaPp][Mm])?)\\s*$",
          "group": 1
        }
      }
    },
