    {
      "id": "google-maps-continue-zh",
      "enabled": true,
      "priority": 50,
      "packageNames": [
        "com.google.android.apps.maps"
      ],
      "comment": "Real zh-TW capture (#17, 2026-08): '前往成功二路' (head toward), with the distance as '0 公尺' in the title or no title at all. No locales on purpose: rules are picked by the phone's language, and the #17 capture came from a phone set to English running Maps in Chinese. Chinese phrases can't collide with other languages. The arrow comes from the large icon when one is matched (same table as google-maps-icon-step), straight otherwise, as for google-maps-toward-en (#104).",
      "conditions": [
        {
          "field": "combinedText",
          "operator": "regex",
          "value": "前往|直行|繼續"
        }
      ],
      "output": {
        "maneuver": {
