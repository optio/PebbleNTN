  "publisher": "PebbleNTN maintainers",
  "rules": [
    {
      "id": "google-maps-roundabout-zh",
      "enabled": true,
      "priority": 190,
      "packageNames": [
        "com.google.android.apps.maps"
      ],
      "comment": "Google Maps' Traditional Chinese phrasing; validate against a real capture. No locales on purpose: rules are picked by the phone's language, and the #17 capture came from a phone set to English running Maps in Chinese. Chinese phrases can't collide with other languages.",
      "conditions": [
        {
          "field": "combinedText",
          "operator": "regex",
          "value": "圓環|環島"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
          "value": "ROUNDABOUT"
        },
        "distanceMeters": {
          "type": "distance",
          "field": "title"
        },
        "primaryText": {
          "type": "firstNonEmpty",
          "fields": [
            "text",
            "title"
          ],
          "stripLeadingDistance": true
        },
        "secondaryText": {
          "type": "regexCapture",
          "field": "subText",
          "pattern": "(\\d{1,2}:\\d{2})",
          "group": 1
        }
      }
    },
