    {
      "id": "google-maps-arrive-zh",
      "enabled": true,
      "priority": 40,
      "packageNames": [
        "com.google.android.apps.maps"
      ],
      "comment": "Google Maps' Traditional Chinese phrasing; validate against a real capture. '抵達', never '到達': the ETA line is '預計到達時間：13:24' on every card. No locales on purpose: rules are picked by the phone's language, and the #17 capture came from a phone set to English running Maps in Chinese. Chinese phrases can't collide with other languages.",
      "conditions": [
        {
          "field": "combinedText",
          "operator": "regex",
          "value": "抵達"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
          "value": "ARRIVE"
        },
        "primaryText": {
          "type": "firstNonEmpty",
          "fields": [
            "text",
            "title"
          ],
          "stripLeadingDistance": true
        },
        "secondaryText": {
