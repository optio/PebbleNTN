  "rules": [
    {
      "id": "google-maps-roundabout-pt",
      "enabled": true,
      "priority": 190,
      "packageNames": [
        "com.google.android.apps.maps"
      ],
      "locales": [
        "pt"
      ],
      "conditions": [
        {
          "field": "combinedText",
          "operator": "regex",
          "value": "(?i)\\b(?:rotunda|rotat\\S*ria)\\b"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
          "value": "ROUNDABOUT"
        },
        "distanceMeters": {
          "type": "distance",
          "field": "combinedText"
        },
        "primaryText": {
          "type": "firstNonEmpty",
          "fields": [
            "title",
            "text"
          ],
          "stripLeadingDistance": true
        },
        "secondaryText": {
          "type": "regexCapture",
          "field": "subText",
          "pattern": "(?i)(\\d{1,2}:\\d{2}(?:\\s*[AaPp][Mm])?)\\s*$",
          "group": 1
        }
      }
    },
