{
  "schemaVersion": 1,
  "rulesetVersion": "vela-maps-en-2026.10.30",
  "minimumAppVersionCode": 1,
  "createdAt": "2026-10-30T00:00:00Z",
  "publisher": "PebbleNTN maintainers, from the rules proposed by the #120 reporter",
  "rules": [
    {
      "id": "vela-arrived-en",
      "comment": "Vela Maps (#120): title 'Arrived' (values/strings.xml in Vela's source), empty text. Based on the rules proposed by the #120 reporter; synthetic fixtures, to be checked against real captures.",
      "enabled": true,
      "priority": 200,
      "packageNames": ["app.vela"],
      "locales": ["en"],
      "conditions": [
        { "field": "title", "operator": "equalsIgnoreCase", "value": "Arrived" }
      ],
      "output": {
        "maneuver": { "type": "literal", "value": "ARRIVE" },
        "primaryText": { "type": "literal", "value": "Arrived" }
      }
    },
    {
      "id": "vela-in-distance-arrive-en",
      "comment": "Approaching the destination: 'In 500 ft · Your destination is on the right', 'In 100 m · Arrive at destination', 'You have arrived …'. ARRIVE with the distance, as for Google Maps and OsmAnd; above every maneuver rule.",
      "enabled": true,
      "priority": 195,
      "packageNames": ["app.vela"],
      "locales": ["en"],
      "conditions": [
        { "field": "title", "operator": "regex", "value": "(?i)^In\\s+\\d+(?:[.,]\\d+)?\\s*(?:ft|mi|km|m|yd)\\s*·" },
        { "field": "title", "operator": "regex", "value": "(?i)·\\s*(?:your\\s+(?:\\w+\\s+)?destination\\b|you\\s+(?:have|will)\\s+arrive|arrive(?:d)?\\b)" }
      ],
      "output": {
        "maneuver": { "type": "literal", "value": "ARRIVE" },
        "distanceMeters": { "type": "distance", "field": "title" },
        "primaryText": { "type": "regexCapture", "field": "title", "pattern": "(?i)^In\\s+[^·]+·\\s*(.+)$", "group": 1 },
        "secondaryText": { "type": "regexCapture", "field": "text", "pattern": "(?i)\\bArrive\\s+(\\d{1,2}:\\d{2}(?:\\s*[AaPp]\\.?[Mm]\\.?)?)", "group": 1 }
      }
    },
    {
      "id": "vela-in-distance-exit-left-en",
      "comment": "A motorway exit or ramp on the left: 'Take exit 12 on the left', 'Take the ramp on the left', 'Exit left'. SLIGHT_LEFT. Never a roundabout exit ('roundabout' or 'take the 2nd exit'), which the roundabout rule takes.",
      "enabled": true,
      "priority": 190,
      "packageNames": ["app.vela"],
      "locales": ["en"],
      "conditions": [
        { "field": "title", "operator": "regex", "value": "(?i)^In\\s+\\d+(?:[.,]\\d+)?\\s*(?:ft|mi|km|m|yd)\\s*·" },
        { "field": "title", "operator": "regex", "value": "(?i)·\\s*(?![^·]*\\b(?:roundabout|rotary|traffic\\s+circle)\\b)(?!take\\s+the\\s+(?:\\d+(?:st|nd|rd|th)|first|second|third|fourth|fifth|sixth|seventh|eighth)\\s+exit\\b)(?:take\\b[^·]*?\\b(?:exit|ramp)\\b|(?:exit|ramp)\\b)(?=[^·]*\\b(?:on\\s+the\\s+left|(?:exit|ramp)\\s+left|left\\s+(?:exit|ramp))\\b)" }
      ],
      "output": {
        "maneuver": { "type": "literal", "value": "SLIGHT_LEFT" },
        "distanceMeters": { "type": "distance", "field": "title" },
        "primaryText": { "type": "regexCapture", "field": "title", "pattern": "(?i)^In\\s+[^·]+·\\s*(.+)$", "group": 1 },
        "secondaryText": { "type": "regexCapture", "field": "text", "pattern": "(?i)\\bArrive\\s+(\\d{1,2}:\\d{2}(?:\\s*[AaPp]\\.?[Mm]\\.?)?)", "group": 1 }
      }
    },
    {
      "id": "vela-in-distance-exit-en",
      "comment": "A motorway exit or ramp: 'Take the I 35 South exit toward Dallas' (Valhalla), 'Take the ramp on the right', 'Take the exit'. SLIGHT_RIGHT unless the left rule above took it. Above the roundabout rule, but never a roundabout exit.",
      "enabled": true,
      "priority": 185,
      "packageNames": ["app.vela"],
      "locales": ["en"],
      "conditions": [
        { "field": "title", "operator": "regex", "value": "(?i)^In\\s+\\d+(?:[.,]\\d+)?\\s*(?:ft|mi|km|m|yd)\\s*·" },
        { "field": "title", "operator": "regex", "value": "(?i)·\\s*(?![^·]*\\b(?:roundabout|rotary|traffic\\s+circle)\\b)(?!take\\s+the\\s+(?:\\d+(?:st|nd|rd|th)|first|second|third|fourth|fifth|sixth|seventh|eighth)\\s+exit\\b)(?:take\\b[^·]*?\\b(?:exit|ramp)\\b|(?:exit|ramp)\\b)" }
      ],
      "output": {
        "maneuver": { "type": "literal", "value": "SLIGHT_RIGHT" },
        "distanceMeters": { "type": "distance", "field": "title" },
        "primaryText": { "type": "regexCapture", "field": "title", "pattern": "(?i)^In\\s+[^·]+·\\s*(.+)$", "group": 1 },
        "secondaryText": { "type": "regexCapture", "field": "text", "pattern": "(?i)\\bArrive\\s+(\\d{1,2}:\\d{2}(?:\\s*[AaPp]\\.?[Mm]\\.?)?)", "group": 1 }
      }
    },
    {
      "id": "vela-in-distance-roundabout-en",
      "comment": "Roundabouts in every router's wording: 'At the roundabout, take the 2nd exit' (OSRM), 'Enter the roundabout and take the 3rd exit' (Valhalla), 'At roundabout, take exit 2' (GraphHopper), 'Exit the roundabout', 'At the roundabout, turn right'. Above the turn rules.",
      "enabled": true,
      "priority": 180,
      "packageNames": ["app.vela"],
      "locales": ["en"],
      "conditions": [
        { "field": "title", "operator": "regex", "value": "(?i)^In\\s+\\d+(?:[.,]\\d+)?\\s*(?:ft|mi|km|m|yd)\\s*·" },
        { "field": "title", "operator": "regex", "value": "(?i)·\\s*(?:[^·]*\\b(?:roundabout|rotary|traffic\\s+circle)\\b|take\\s+the\\s+(?:\\d+(?:st|nd|rd|th)|first|second|third|fourth|fifth|sixth|seventh|eighth)\\s+exit\\b)" }
      ],
      "output": {
        "maneuver": { "type": "literal", "value": "ROUNDABOUT" },
        "distanceMeters": { "type": "distance", "field": "title" },
        "primaryText": { "type": "regexCapture", "field": "title", "pattern": "(?i)^In\\s+[^·]+·\\s*(.+)$", "group": 1 },
        "secondaryText": { "type": "regexCapture", "field": "text", "pattern": "(?i)\\bArrive\\s+(\\d{1,2}:\\d{2}(?:\\s*[AaPp]\\.?[Mm]\\.?)?)", "group": 1 }
      }
    },
    {
      "id": "vela-in-distance-uturn-right-en",
      "comment": "'Make a right U-turn' (Valhalla in left-hand traffic). UTURN_RIGHT; above the default U-turn rule.",
      "enabled": true,
      "priority": 175,
      "packageNames": ["app.vela"],
      "locales": ["en"],
