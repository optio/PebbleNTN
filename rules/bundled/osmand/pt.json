{
  "schemaVersion": 1,
  "rulesetVersion": "osmand-pt-2026.10.4",
  "minimumAppVersionCode": 1,
  "createdAt": "2026-10-04T00:00:00Z",
  "publisher": "PebbleNTN maintainers",
  "rules": [
    {
      "id": "osmand-roundabout-pt",
      "enabled": true,
      "priority": 190,
      "packageNames": [
        "net.osmand",
        "net.osmand.plus"
      ],
      "locales": [
        "pt"
      ],
      "comment": "From OsmAnd's instruction strings (res/values-pt and values-pt-rBR/strings.xml, 2026-10-04; #61, #57), which its notification shows verbatim. Synthetic until captured. \\b only next to ASCII letters, so JVM, Android and workbench agree. Covers Portugal (values-pt) and Brazil (values-pt-rBR) wording.",
      "conditions": [
        {
          "field": "combinedText",
          "operator": "regex",
          "value": "(?i)\\brotunda\\b|\\brotat\\S*ria\\b|\\bsaia\\s+(?:na\\s+\\d+ª?\\s+sa\\S*da|em\\s+\\d+)|\\bpegue\\s+a\\s+(?:\\d+ª?\\s+sa\\S*da|sa\\S*da\\s+\\d+)"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
          "value": "ROUNDABOUT"
        },
        "distanceMeters": {
          "type": "distance",
          "field": "combinedText"
        },
        "primaryText": {
          "type": "firstNonEmpty",
          "fields": [
            "title",
            "text"
          ],
          "stripLeadingDistance": true
        }
      }
    },
    {
