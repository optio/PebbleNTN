{
  "schemaVersion": 1,
  "rulesetVersion": "osmand-fr-2026.11.10",
  "minimumAppVersionCode": 83,
  "createdAt": "2026-10-04T00:00:00Z",
  "publisher": "PebbleNTN maintainers",
  "rules": [
    {
      "id": "osmand-roundabout-street-fr",
      "enabled": true,
      "priority": 191,
      "packageNames": [
        "net.osmand",
        "net.osmand.plus",
        "net.osmand.dev",
        "net.osmand.huawei"
      ],
      "locales": [
        "fr"
      ],
      "comment": "Variant of osmand-roundabout-fr one step above it (#134): bigText's first line is OsmAnd's instruction (route_roundabout_short 'Prenez la sortie %d'), the street and the next step's distance. Road line: that line without the distance; compact: from 'sortie' on ('sortie 2 Rue Exemple'). Second line and ETA: the summary line's arrival clock.",
      "conditions": [
        {
          "field": "combinedText",
          "operator": "regex",
          "value": "(?i)\\bgiratoire\\b|\\bpren(?:ez|dre)\\s+la\\s+sortie\\s+\\d+"
        },
        {
          "field": "bigText",
          "operator": "regex",
          "value": "(?i)^(?:tournez\\s+à\\s+(?:droite|gauche)|prenez\\s+le\\s+virage\\s+serré\\s+à\\s+(?:droite|gauche)\\s+et\\s+continuez|tournez\\s+légèrement\\s+vers\\s+la\\s+(?:droite|gauche)\\s+et\\s+continuez|faites\\s+demi-tour\\s+et\\s+continuez|serrez\\s+à\\s+(?:droite|gauche)|pren(?:ez|dre)\\s+la\\s+sortie\\s+\\d+|avancez)[^\\S\\n]+(?![\\d.,]+[^\\S\\n]*(?:km|m|mi|pieds|yd|mn)[^\\S\\n]*(?:\\n|$))\\S"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
          "value": "ROUNDABOUT"
        },
        "distanceMeters": {
          "type": "distance",
          "field": "combinedText"
        },
        "primaryText": {
          "type": "regexCapture",
          "field": "bigText",
          "pattern": "(?i)^([^\\n]+?)(?:[^\\S\\n]+[\\d.,]+[^\\S\\n]*(?:km|m|mi|pieds|yd|mn))?[^\\S\\n]*(?:\\n|$)",
          "group": 1
        },
        "compactText": {
          "type": "regexCapture",
          "field": "bigText",
          "pattern": "(?i)^pren(?:ez|dre)\\s+la\\s+(sortie\\s+\\d+[^\\S\\n]+[^\\n]+?)(?:[^\\S\\n]+[\\d.,]+[^\\S\\n]*(?:km|m|mi|pieds|yd|mn))?[^\\S\\n]*(?:\\n|$)",
          "group": 1
        },
        "secondaryText": {
          "type": "regexCapture",
          "field": "bigText",
          "pattern": "(?m)^[^•\\n]+•[^•\\n]+•\\s*([^•\\n]*?\\d{1,2}:\\d{2}[^•\\n]*?)\\s*(?:•|$)",
          "group": 1
        },
        "etaEpochSeconds": {
          "type": "arrivalClock",
          "field": "bigText",
          "pattern": "(?m)^[^•\\n]+•[^•\\n]+•\\s*([^•\\n]*?\\d{1,2}:\\d{2}[^•\\n]*?)\\s*(?:•|$)",
          "group": 1
        }
      }
    },
    {
      "id": "osmand-roundabout-fr",
      "enabled": true,
      "priority": 190,
      "packageNames": [
        "net.osmand",
        "net.osmand.plus",
