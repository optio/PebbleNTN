      "conditions": [
        {
          "field": "combinedText",
          "operator": "regex",
          "value": "(?i)\\bgiratoire\\b|\\bpren(?:ez|dre)\\s+la\\s+sortie\\s+\\d+"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
          "value": "ROUNDABOUT"
