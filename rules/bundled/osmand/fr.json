{
  "schemaVersion": 1,
  "rulesetVersion": "osmand-fr-2026.10.4",
  "minimumAppVersionCode": 1,
  "createdAt": "2026-10-04T00:00:00Z",
  "publisher": "PebbleNTN maintainers",
  "rules": [
    {
      "id": "osmand-roundabout-fr",
      "enabled": true,
      "priority": 190,
      "packageNames": [
        "net.osmand",
        "net.osmand.plus"
      ],
      "locales": [
        "fr"
      ],
      "comment": "From OsmAnd's instruction strings (res/values-fr/strings.xml, 2026-10-04; #61, #57), which its notification shows verbatim. Synthetic until captured. \\b only next to ASCII letters, so JVM, Android and workbench agree. 'Prenez la sortie %d' is OsmAnd's roundabout short form; motorway exits are announced with the keep strings.",
      "conditions": [
        {
          "field": "combinedText",
          "operator": "regex",
          "value": "(?i)\\bgiratoire\\b|\\bpren(?:ez|dre)\\s+la\\s+sortie\\s+\\d+"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
          "value": "ROUNDABOUT"
        },
        "distanceMeters": {
          "type": "distance",
          "field": "combinedText"
        },
        "primaryText": {
          "type": "firstNonEmpty",
          "fields": [
            "title",
            "text"
          ],
          "stripLeadingDistance": true
        }
      }
    },
