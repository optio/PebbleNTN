      ],
      "locales": [
        "it"
      ],
      "comment": "Authored from OsmAnd's Italian phrasing; validate against a real capture. Lowest priority, so a maneuver word always wins over a road name such as 'Via dell'Arrivo'.",
      "conditions": [
        {
          "field": "combinedText",
          "operator": "regex",
          "value": "(?i)\\b(?:arrivo|arrivato|arrivata|arrivati|destinazione)\\b"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
