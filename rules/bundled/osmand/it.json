      "comment": "Authored from OsmAnd's Italian phrasing; validate against a real capture. Cross-checked against OsmAnd's strings (2026-10, #61): OsmAnd says 'Rotatoria: prendere la %d uscita' (route_roundabout), and the short forms 'Prendere la %d uscita', 'Prendi l'uscita %d', 'Prendi la %d uscita e tieni la sinistra' have no 'rotatoria'.",
      "conditions": [
        {
          "field": "combinedText",
          "operator": "regex",
          "value": "(?i)\\brotond[ae]\\b|\\brotatoria\\b|\\bprend(?:i|ere)\\s+(?:la\\s+\\d+\\s+uscita|l['’]uscita\\s+\\d+)"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
          "value": "ROUNDABOUT"
        },
        "distanceMeters": {
          "type": "distance",
          "field": "combinedText"
        },
        "primaryText": {
          "type": "firstNonEmpty",
          "fields": [
            "title",
            "text"
          ],
          "stripLeadingDistance": true
        },
        "secondaryText": {
          "type": "regexCapture",
          "field": "bigText",
          "pattern": "(?m)^[^•\\n]+•[^•\\n]+•\\s*([^•\\n]*?\\d{1,2}:\\d{2}[^•\\n]*?)\\s*(?:•|$)",
          "group": 1
        },
        "etaEpochSeconds": {
          "type": "arrivalClock",
          "field": "bigText",
          "pattern": "(?m)^[^•\\n]+•[^•\\n]+•\\s*([^•\\n]*?\\d{1,2}:\\d{2}[^•\\n]*?)\\s*(?:•|$)",
          "group": 1
        }
