  "rules": [
    {
      "id": "osmand-roundabout-it",
      "enabled": true,
      "priority": 190,
      "packageNames": [
        "net.osmand",
        "net.osmand.plus"
      ],
      "locales": [
        "it"
      ],
      "comment": "Authored from OsmAnd's Italian phrasing; validate against a real capture.",
      "conditions": [
        {
          "field": "combinedText",
          "operator": "regex",
          "value": "(?i)\\brotond[ae]\\b"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
          "value": "ROUNDABOUT"
        },
        "distanceMeters": {
          "type": "distance",
          "field": "combinedText"
        },
        "primaryText": {
          "type": "firstNonEmpty",
          "fields": [
            "title",
            "text"
          ],
          "stripLeadingDistance": true
        }
      }
    },
