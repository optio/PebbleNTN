{
  "schemaVersion": 1,
  "rulesetVersion": "osmand-it-2026.11.10",
  "minimumAppVersionCode": 83,
  "createdAt": "2026-10-01T00:00:00Z",
  "publisher": "PebbleNTN maintainers",
  "rules": [
    {
      "id": "osmand-roundabout-street-it",
      "enabled": true,
      "priority": 191,
      "packageNames": [
        "net.osmand",
        "net.osmand.plus",
        "net.osmand.dev",
        "net.osmand.huawei"
      ],
      "locales": [
        "it"
      ],
      "comment": "Variant of osmand-roundabout-it one step above it (#134): bigText's first line is OsmAnd's instruction (route_roundabout_short 'Prendere la %d uscita e proseguire'), the street and the next step's distance. Road line: that line without the distance; compact: from the exit number on. Second line and ETA: the summary line's arrival clock.",
      "conditions": [
        {
          "field": "combinedText",
          "operator": "regex",
          "value": "(?i)\\brotond[ae]\\b|\\brotatoria\\b|\\bprend(?:i|ere)\\s+(?:la\\s+\\d+\\s+uscita|l['’]uscita\\s+\\d+)"
        },
        {
          "field": "bigText",
          "operator": "regex",
          "value": "(?i)^(?:svolta\\s+(?:stretto\\s+|leggermente\\s+)?a\\s+(?:destra|sinistra)\\s+e\\s+prosegui\\s+su|fai\\s+inversione\\s+a\\s+u\\s+e\\s+continua|tieni\\s+la\\s+(?:destra|sinistra)\\s+e\\s+prosegui|prendere\\s+la\\s+\\d+\\s+uscita\\s+e\\s+proseguire|prendi\\s+l['’]uscita\\s+\\d+|avanti)[^\\S\\n]+(?![\\d.,]+[^\\S\\n]*(?:km|m|piede|yarda|nmi)[^\\S\\n]*(?:\\n|$))\\S"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
          "value": "ROUNDABOUT"
        },
        "distanceMeters": {
          "type": "distance",
          "field": "combinedText"
        },
        "primaryText": {
          "type": "regexCapture",
          "field": "bigText",
          "pattern": "(?i)^([^\\n]+?)(?:[^\\S\\n]+[\\d.,]+[^\\S\\n]*(?:km|m|piede|yarda|nmi))?[^\\S\\n]*(?:\\n|$)",
          "group": 1
        },
        "compactText": {
          "type": "regexCapture",
          "field": "bigText",
          "pattern": "(?i)^prend(?:ere\\s+la\\s+|i\\s+l['’])((?:\\d+\\s+uscita\\s+e\\s+proseguire|uscita\\s+\\d+)[^\\S\\n]+[^\\n]+?)(?:[^\\S\\n]+[\\d.,]+[^\\S\\n]*(?:km|m|piede|yarda|nmi))?[^\\S\\n]*(?:\\n|$)",
          "group": 1
        },
        "secondaryText": {
          "type": "regexCapture",
          "field": "bigText",
          "pattern": "(?m)^[^•\\n]+•[^•\\n]+•\\s*([^•\\n]*?\\d{1,2}:\\d{2}[^•\\n]*?)\\s*(?:•|$)",
          "group": 1
        },
        "etaEpochSeconds": {
          "type": "arrivalClock",
          "field": "bigText",
          "pattern": "(?m)^[^•\\n]+•[^•\\n]+•\\s*([^•\\n]*?\\d{1,2}:\\d{2}[^•\\n]*?)\\s*(?:•|$)",
          "group": 1
        }
      }
    },
    {
      "id": "osmand-roundabout-it",
      "enabled": true,
      "priority": 190,
      "packageNames": [
        "net.osmand",
