{
  "schemaVersion": 1,
  "rulesetVersion": "osmand-nl-2026.10.4",
  "minimumAppVersionCode": 1,
  "createdAt": "2026-10-04T00:00:00Z",
  "publisher": "PebbleNTN maintainers",
  "rules": [
    {
      "id": "osmand-roundabout-nl",
      "enabled": true,
      "priority": 190,
      "packageNames": [
        "net.osmand",
        "net.osmand.plus"
      ],
      "locales": [
        "nl"
      ],
      "comment": "From OsmAnd's instruction strings (res/values-nl/strings.xml, 2026-10-04; #61, #57), which its notification shows verbatim. Synthetic until captured. \\b only next to ASCII letters, so JVM, Android and workbench agree. 'volg' ends every Dutch instruction ('… en volg'), so the continue rule only takes it at the start of the step.",
      "conditions": [
        {
          "field": "combinedText",
          "operator": "regex",
          "value": "(?i)\\brotonde\\b|\\bneem\\s+\\d+(?:e|de)?\\s+afslag\\b|\\bafslag\\s+\\d+\\s+nemen\\b"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
          "value": "ROUNDABOUT"
        },
        "distanceMeters": {
          "type": "distance",
          "field": "combinedText"
        },
        "primaryText": {
          "type": "firstNonEmpty",
          "fields": [
            "title",
            "text"
          ],
          "stripLeadingDistance": true
        }
      }
    },
