{
  "schemaVersion": 1,
  "rulesetVersion": "osmand-nl-2026.11.10",
  "minimumAppVersionCode": 83,
  "createdAt": "2026-10-04T00:00:00Z",
  "publisher": "PebbleNTN maintainers",
  "rules": [
    {
      "id": "osmand-roundabout-street-nl",
      "enabled": true,
      "priority": 191,
      "packageNames": [
        "net.osmand",
        "net.osmand.plus",
        "net.osmand.dev",
        "net.osmand.huawei"
      ],
      "locales": [
        "nl"
      ],
      "comment": "Variant of osmand-roundabout-nl one step above it (#134): bigText's first line is OsmAnd's instruction (route_roundabout_short 'Neem %de afslag'), the street and the next step's distance. Road line: that line without the distance; compact: from the exit number on ('2e afslag Voorbeeldweg'). Second line and ETA: the summary line's arrival clock.",
      "conditions": [
        {
          "field": "combinedText",
          "operator": "regex",
          "value": "(?i)\\brotonde\\b|\\bneem\\s+\\d+(?:e|de)?\\s+afslag\\b|\\bafslag\\s+\\d+\\s+nemen\\b"
        },
        {
          "field": "bigText",
          "operator": "regex",
          "value": "(?i)^(?:sla\\s+(?:scherp\\s+)?(?:rechtsaf|linksaf)\\s+en\\s+volg|buig\\s+(?:af\\s+naar\\s+)?(?:rechts|links)(?:af)?\\s+en\\s+volg|keer\\s+om\\s+en\\s+volg|(?:links|rechts)\\s+aanhouden\\s+en\\s+volg|neem\\s+\\d+(?:e|de)?\\s+afslag|volg)[^\\S\\n]+(?![\\d.,]+[^\\S\\n]*(?:km|m|mijl|voet|yard|nmi)[^\\S\\n]*(?:\\n|$))\\S"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
          "value": "ROUNDABOUT"
        },
        "distanceMeters": {
          "type": "distance",
          "field": "combinedText"
        },
        "primaryText": {
          "type": "regexCapture",
          "field": "bigText",
          "pattern": "(?i)^([^\\n]+?)(?:[^\\S\\n]+[\\d.,]+[^\\S\\n]*(?:km|m|mijl|voet|yard|nmi))?[^\\S\\n]*(?:\\n|$)",
          "group": 1
        },
        "compactText": {
          "type": "regexCapture",
          "field": "bigText",
          "pattern": "(?i)^neem\\s+(\\d+(?:e|de)?\\s+afslag[^\\S\\n]+[^\\n]+?)(?:[^\\S\\n]+[\\d.,]+[^\\S\\n]*(?:km|m|mijl|voet|yard|nmi))?[^\\S\\n]*(?:\\n|$)",
          "group": 1
        },
        "secondaryText": {
          "type": "regexCapture",
          "field": "bigText",
          "pattern": "(?m)^[^•\\n]+•[^•\\n]+•\\s*([^•\\n]*?\\d{1,2}:\\d{2}[^•\\n]*?)\\s*(?:•|$)",
          "group": 1
        },
        "etaEpochSeconds": {
          "type": "arrivalClock",
          "field": "bigText",
          "pattern": "(?m)^[^•\\n]+•[^•\\n]+•\\s*([^•\\n]*?\\d{1,2}:\\d{2}[^•\\n]*?)\\s*(?:•|$)",
          "group": 1
        }
      }
    },
    {
