          "stripLeadingDistance": true
        },
        "secondaryText": {
          "type": "regexCapture",
          "field": "bigText",
          "pattern": "(?im)^([\\d.,]+\\s*k?m)\\s*•\\s*(?:\\d+\\s*h(?:\\s*<?\\s*\\d+\\s*min)?|<?\\s*\\d+\\s*min)\\s*•\\s*\\d{1,2}:\\d{2}\\b",
          "group": 1
        }
      }
    },
    {
      "id": "osmand-sharp-left-street-de",
      "enabled": true,
      "priority": 171,
