          "field": "bigText",
          "operator": "regex",
          "value": "(?i)\\bscharf\\s+links\\b[^\\n]*?,\\s*dann\\s+(?![\\d.,]+\\s*k?m\\s*(?:\\n|$)).+?\\s+[\\d.,]+\\s*k?m\\s*(?:\\n|$)"
