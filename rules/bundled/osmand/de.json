      "comment": "Contributed by a user via \"Share your rules\" (2026-10, #61) and checked against OsmAnd's German strings (OsmAnd/res/values-de/strings.xml): 'Wenden' (route_tu). Secondary line: the remaining route distance from bigText's summary line (#76).",
      "conditions": [
        {
          "field": "title",
          "operator": "regex",
          "value": "(?i)•\\s*(?:wenden|umkehren|u-turn)\\b"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
          "value": "UTURN_LEFT"
        },
        "distanceMeters": {
          "type": "distance",
          "field": "combinedText"
        },
        "primaryText": {
          "type": "firstNonEmpty",
          "fields": [
            "title",
            "text"
