{
  "schemaVersion": 1,
  "rulesetVersion": "osmand-pl-2026.11.10",
  "minimumAppVersionCode": 83,
  "createdAt": "2026-10-04T00:00:00Z",
  "publisher": "PebbleNTN maintainers",
  "rules": [
    {
      "id": "osmand-roundabout-street-pl",
      "enabled": true,
      "priority": 191,
      "packageNames": [
        "net.osmand",
        "net.osmand.plus",
        "net.osmand.dev",
        "net.osmand.huawei"
      ],
      "locales": [
        "pl"
      ],
      "comment": "Variant of osmand-roundabout-pl one step above it (#134): bigText's first line is OsmAnd's instruction (route_roundabout_short 'Zjedź %d zjazdem'), the street and the next step's distance. Road line: that line without the distance; compact: from the exit number on ('2 zjazdem ul. Przykładowa'). Second line and ETA: the summary line's arrival clock.",
      "conditions": [
        {
          "field": "combinedText",
          "operator": "regex",
          "value": "(?i)\\brondzie\\b|\\bzjed\\S*\\s+(?:\\d+\\s+zjazdem|zjazdem\\s+(?:numer\\s+)?\\d+)"
        },
        {
          "field": "bigText",
          "operator": "regex",
          "value": "(?i)^(?:skręć\\s+(?:ostro\\s+|łagodnie\\s+)?w\\s+(?:prawo|lewo)\\s+i\\s+jedź|zawróć\\s+i\\s+jedź|trzymaj\\s+się\\s+(?:lewej|prawej)\\s+strony|zjedź\\s+(?:\\d+\\s+zjazdem|zjazdem\\s+numer\\s+\\d+)|prosto)[^\\S\\n]+(?![\\d.,]+[^\\S\\n]*(?:km|m|mi|stopy|yd|Mm)[^\\S\\n]*(?:\\n|$))\\S"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
          "value": "ROUNDABOUT"
        },
        "distanceMeters": {
          "type": "distance",
          "field": "combinedText"
        },
        "primaryText": {
          "type": "regexCapture",
          "field": "bigText",
          "pattern": "(?i)^([^\\n]+?)(?:[^\\S\\n]+[\\d.,]+[^\\S\\n]*(?:km|m|mi|stopy|yd|Mm))?[^\\S\\n]*(?:\\n|$)",
          "group": 1
        },
        "compactText": {
          "type": "regexCapture",
          "field": "bigText",
          "pattern": "(?i)^zjedź\\s+((?:\\d+\\s+zjazdem|zjazdem\\s+numer\\s+\\d+)[^\\S\\n]+[^\\n]+?)(?:[^\\S\\n]+[\\d.,]+[^\\S\\n]*(?:km|m|mi|stopy|yd|Mm))?[^\\S\\n]*(?:\\n|$)",
          "group": 1
        },
        "secondaryText": {
          "type": "regexCapture",
          "field": "bigText",
          "pattern": "(?m)^[^•\\n]+•[^•\\n]+•\\s*([^•\\n]*?\\d{1,2}:\\d{2}[^•\\n]*?)\\s*(?:•|$)",
          "group": 1
        },
        "etaEpochSeconds": {
          "type": "arrivalClock",
          "field": "bigText",
          "pattern": "(?m)^[^•\\n]+•[^•\\n]+•\\s*([^•\\n]*?\\d{1,2}:\\d{2}[^•\\n]*?)\\s*(?:•|$)",
          "group": 1
        }
      }
    },
    {
