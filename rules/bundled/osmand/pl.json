  "rules": [
    {
      "id": "osmand-roundabout-pl",
      "enabled": true,
      "priority": 190,
      "packageNames": [
        "net.osmand",
        "net.osmand.plus"
      ],
      "locales": [
        "pl"
      ],
      "comment": "From OsmAnd's instruction strings (res/values-pl/strings.xml, 2026-10-04; #61, #57), which its notification shows verbatim. Synthetic until captured. \\b only next to ASCII letters, so JVM, Android and workbench agree.",
      "conditions": [
        {
          "field": "combinedText",
          "operator": "regex",
          "value": "(?i)\\brondzie\\b|\\bzjed\\S*\\s+(?:\\d+\\s+zjazdem|zjazdem\\s+(?:numer\\s+)?\\d+)"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
          "value": "ROUNDABOUT"
        },
        "distanceMeters": {
          "type": "distance",
          "field": "combinedText"
        },
        "primaryText": {
          "type": "firstNonEmpty",
          "fields": [
            "title",
            "text"
          ],
          "stripLeadingDistance": true
        }
      }
    },
