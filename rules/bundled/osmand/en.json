{
  "schemaVersion": 1,
  "rulesetVersion": "osmand-en-2026.08.1",
  "minimumAppVersionCode": 1,
  "createdAt": "2026-08-05T00:00:00Z",
  "publisher": "PebbleNTN maintainers",
  "rules": [
    {
      "id": "osmand-roundabout-en",
      "enabled": true,
      "priority": 190,
      "packageNames": [
        "net.osmand",
        "net.osmand.plus"
      ],
      "locales": [
        "en"
      ],
      "comment": "Authored from OsmAnd's English phrasing; validate against a real roundabout capture.",
      "conditions": [
        {
          "field": "combinedText",
          "operator": "regex",
          "value": "(?i)\\broundabout\\b"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
          "value": "ROUNDABOUT"
        },
        "distanceMeters": {
          "type": "distance",
          "field": "combinedText"
        },
        "primaryText": {
          "type": "firstNonEmpty",
          "fields": [
            "title",
            "text"
          ]
        }
      }
    },
    {
      "id": "osmand-uturn-en",
