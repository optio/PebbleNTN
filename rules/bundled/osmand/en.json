    {
      "id": "osmand-turn-right-en",
      "enabled": true,
      "priority": 100,
      "packageNames": [
        "net.osmand",
        "net.osmand.plus"
      ],
      "locales": [
        "en"
      ],
      "comment": "Capture-confirmed (2026-08, en). OsmAnd title format is '<distance> • Turn right and go ...'; distance is the leading number+unit.",
      "conditions": [
        {
          "field": "combinedText",
          "operator": "regex",
          "value": "(?i)\\bturn\\s+right\\b"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
          "value": "RIGHT"
        },
        "distanceMeters": {
          "type": "distance",
          "field": "combinedText"
