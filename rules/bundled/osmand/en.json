    {
      "id": "osmand-continue-en",
      "enabled": true,
      "priority": 50,
      "packageNames": [
        "net.osmand",
        "net.osmand.plus"
      ],
      "locales": [
        "en"
      ],
      "comment": "Matches 'Go straight'/'Continue' only, never the bare 'and go' that ends every OsmAnd turn title.",
      "conditions": [
        {
          "field": "combinedText",
          "operator": "regex",
          "value": "(?i)\\b(?:go\\s+straight|continue)\\b"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
          "value": "STRAIGHT"
        },
        "distanceMeters": {
          "type": "distance",
          "field": "combinedText"
        },
        "primaryText": {
          "type": "firstNonEmpty",
          "fields": [
            "title",
            "text"
          ]
        }
      }
    },
    {
      "id": "osmand-arrive-en",
      "enabled": true,
      "priority": 40,
      "packageNames": [
        "net.osmand",
        "net.osmand.plus"
      ],
      "locales": [
        "en"
      ],
      "comment": "Lowest priority, title only: the title carries the destination road name, so an explicit maneuver must win and only a maneuver-less title falls through to ARRIVE (same lesson as the localized Google Maps fix). Authored from OsmAnd phrasing; validate against a real arrival capture.",
      "conditions": [
        {
          "field": "title",
          "operator": "regex",
          "value": "(?i)\\b(?:arrive|arrived|reached|destination)\\b"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
          "value": "ARRIVE"
        },
        "primaryText": {
          "type": "firstNonEmpty",
          "fields": [
            "title",
            "text"
          ]
        }
      }
    }
