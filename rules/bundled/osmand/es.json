{
  "schemaVersion": 1,
  "rulesetVersion": "osmand-es-2026.11.10",
  "minimumAppVersionCode": 83,
  "createdAt": "2026-10-04T00:00:00Z",
  "publisher": "PebbleNTN maintainers",
  "rules": [
    {
      "id": "osmand-roundabout-street-es",
      "enabled": true,
      "priority": 191,
      "packageNames": [
        "net.osmand",
        "net.osmand.plus",
        "net.osmand.dev",
        "net.osmand.huawei"
      ],
      "locales": [
        "es"
      ],
      "comment": "Variant of osmand-roundabout-es one step above it (#134): bigText's first line is OsmAnd's instruction (route_roundabout_short 'Toma la %dª salida y continúa'), the street and the next step's distance. Road line: that line without the distance; compact: from the exit number on. Second line and ETA: the summary line's arrival clock.",
      "conditions": [
        {
          "field": "combinedText",
          "operator": "regex",
          "value": "(?i)\\brotonda\\b|\\btoma\\s+la\\s+(?:\\d+ª?\\s+salida|salida\\s+\\d+)"
        },
        {
          "field": "bigText",
          "operator": "regex",
          "value": "(?i)^(?:gira\\s+(?:fuerte\\s+|leve\\s+)?a\\s+la\\s+(?:derecha|izquierda)\\s+en|cambia\\s+de\\s+sentido\\s+en|mantente\\s+a\\s+la\\s+(?:derecha|izquierda)\\s+y\\s+continúa\\s+por|toma\\s+la\\s+\\d+ª?\\s+salida(?:\\s+y\\s+continúa|(?!\\s+y\\s+continúa))|inicia\\s+en)[^\\S\\n]+(?![\\d.,]+[^\\S\\n]*(?:km|m|mi|ft|yd|nmi)[^\\S\\n]*(?:\\n|$))\\S"
        }
      ],
      "output": {
        "maneuver": {
          "type": "literal",
          "value": "ROUNDABOUT"
        },
        "distanceMeters": {
          "type": "distance",
          "field": "combinedText"
        },
        "primaryText": {
          "type": "regexCapture",
          "field": "bigText",
          "pattern": "(?i)^([^\\n]+?)(?:[^\\S\\n]+[\\d.,]+[^\\S\\n]*(?:km|m|mi|ft|yd|nmi))?[^\\S\\n]*(?:\\n|$)",
          "group": 1
        },
        "compactText": {
          "type": "regexCapture",
          "field": "bigText",
          "pattern": "(?i)^toma\\s+la\\s+(\\d+ª?\\s+salida(?:\\s+y\\s+continúa)?[^\\S\\n]+[^\\n]+?)(?:[^\\S\\n]+[\\d.,]+[^\\S\\n]*(?:km|m|mi|ft|yd|nmi))?[^\\S\\n]*(?:\\n|$)",
          "group": 1
        },
        "secondaryText": {
          "type": "regexCapture",
          "field": "bigText",
          "pattern": "(?m)^[^•\\n]+•[^•\\n]+•\\s*([^•\\n]*?\\d{1,2}:\\d{2}[^•\\n]*?)\\s*(?:•|$)",
          "group": 1
        },
        "etaEpochSeconds": {
          "type": "arrivalClock",
          "field": "bigText",
          "pattern": "(?m)^[^•\\n]+•[^•\\n]+•\\s*([^•\\n]*?\\d{1,2}:\\d{2}[^•\\n]*?)\\s*(?:•|$)",
          "group": 1
        }
      }
    },
