    <!-- Onboarding -->
    <string name="onboarding_title">Welcome to PebbleNTN</string>
    <string name="onboarding_intro">PebbleNTN turns navigation-app notifications into turn-by-turn instructions on your Pebble watch.</string>
    <!-- Prominent disclosure required before opening notification-listener settings (REQ-SEC-004). -->
    <string name="onboarding_disclosure">PebbleNTN reads notifications from supported navigation apps, extracts upcoming turn information, and sends it to your Pebble watch. Every supported app is enabled by default when installed; you can turn any of them off in Manage navigation apps. Processing occurs on this device. Notification content is not uploaded automatically. Diagnostic files are shared only when you explicitly export them. The app connects to the network only to check GitHub for a newer app version — when you tap Check for updates, or, if you turn on weekly checks, about once a week — and this sends no personal data.</string>
    <string name="onboarding_open_settings">Grant notification access</string>
    <string name="onboarding_privacy_note">You can turn off any navigation app in Manage navigation apps, or revoke notification access entirely at any time in system settings.</string>

