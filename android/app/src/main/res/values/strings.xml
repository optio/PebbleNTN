    <!-- Export -->
    <!-- Exact required privacy explanation (REQ-DEBUG-007, spec/600-security-release). -->
    <string name="export_privacy_warning">Diagnostic notification content can contain only information that the navigation app placed in its Android notification. This can still include private information such as destinations, road names, saved-place labels, route context, and travel timing.</string>

    <!-- Share-to-help flow (REQ-DEBUG-011). The recipient is filled in by the maintainer; leaving it
         empty just means the user types the address in their mail app. -->
    <string name="dashboard_share_nudge_title">Help add app support</string>
    <string name="dashboard_share_nudge_body">PebbleNTN captured navigation notifications from apps it can\'t turn into watch directions yet (%1$d so far). Sharing these logs helps add support.</string>
    <string name="dashboard_share_nudge_action">Review &amp; share</string>
    <string name="share_diag_title">Share diagnostics</string>
    <string name="share_diag_explainer">Sharing capture logs helps add turn-by-turn support for more navigation apps and languages. Choose what to include, review it below, and send it yourself: by email or with any app. Nothing is sent automatically.</string>
    <string name="share_diag_mode_label">What to include</string>
    <string name="share_diag_mode_redacted">Redacted (road names removed)</string>
    <string name="share_diag_mode_full">Include street names</string>
    <string name="share_diag_mode_redacted_hint">Road names, destinations and other free text are removed (shown as ▮). Only maneuver words, numbers and units remain.</string>
    <string name="share_diag_mode_full_hint">Keeps the full notification text, including street names, destinations and route context. More valuable: it lets us add missing translations for turn and direction words in your language.</string>
    <string name="share_diag_summary">%1$d events · %2$s</string>
    <string name="share_diag_truncated">Older events were left out to keep the attachment under 10 MB (newest %1$d of %2$d included).</string>
    <string name="share_diag_preview_label">Data to be shared (review)</string>
    <string name="share_diag_preview_trimmed">Preview shortened for display — the attached file contains all %1$d events.</string>
    <string name="share_diag_share_email">Share via email</string>
    <string name="share_diag_empty">There are no captured notifications to share yet. You can still share your rules.</string>
    <!-- Recipient for shared capture logs. Set by the maintainer; empty = user fills it in the mail app. -->
    <string name="share_logs_recipient">pebblentn@mg.mijnesite.be</string>
    <string name="share_logs_subject">PebbleNTN capture logs (help add app support)</string>
    <string name="share_logs_body">Attached are privacy-safe PebbleNTN capture logs to help add support for a navigation app. Road names and other free text have been redacted; no personal data is included.</string>

