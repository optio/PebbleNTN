    <!-- Onboarding -->
    <string name="onboarding_title">Welcome to PebbleNTN</string>
    <string name="onboarding_intro">PebbleNTN turns navigation-app notifications into turn-by-turn instructions on your Pebble watch.</string>
    <!-- Exact prominent disclosure required before opening notification-listener settings (REQ-SEC-004). -->
    <string name="onboarding_disclosure">PebbleNTN reads notifications from navigation apps you enable, extracts upcoming turn information, and sends it to your Pebble watch. Processing occurs on this device. Notification content is not uploaded automatically. Diagnostic files are shared only when you explicitly export them. The app connects to the network only to check GitHub for a newer app version — when you tap Check for updates, or, if you turn on weekly checks, about once a week — and this sends no personal data.</string>
    <string name="onboarding_open_settings">Grant notification access</string>
    <string name="onboarding_privacy_note">You can disable any app or revoke access at any time in system settings.</string>

